---
import Layout from '../layouts/Layout.astro';

const work = [
  {
    title: 'Senior Software Engineer',
    company: 'Tabit GmbH',
    companyUrl: 'https://www.tabit.de',
    extra: 'client: Infineon Technologies',
    extraUrl: 'https://www.infineon.com',
    location: 'Munich, Germany',
    dates: 'Feb 2024 – Oct 2026',
    points: [
      'Designed and developed, as main contributor, a next-generation Python test automation framework for component verification: a unified, channel-oriented instrument API built on the IVI standard, analog and digital-pattern stimuli, and a test bench abstraction that auto-detects connected lab instruments.',
      'Modeled the framework architecture in UML to define component interfaces and interactions.',
      'Built C driver extensions for the lab instruments used in component verification tests.',
      'Derived test specifications from product requirements and ran them on lab test benches.',
      'Collaborated with hardware and validation engineers to troubleshoot test setups and device behavior.',
      'Created CI pipelines for unit and integration tests, cutting test time from 1 hour to 10 minutes.',
    ],
    tech: 'C, Python, IVI, MATLAB, Docker, Git, GitLab CI, Jira, UML.',
  },
  {
    title: 'Co-founder & Software Engineer (part-time side project)',
    company: 'Muaslat',
    companyUrl: 'https://muaslat.com',
    location: 'Jordan',
    dates: '2023 – 2024',
    points: [
      "Built Flutter apps, a Django/PostGIS REST API and a Vue back office for live tracking of Jordan's public minibuses.",
    ],
  },
  {
    title: 'Software Robotics Engineer',
    company: 'Agile Robots AG',
    companyUrl: 'https://www.agile-robots.com',
    location: 'Munich, Germany',
    dates: 'Apr 2021 – Sep 2022',
    points: [
      'Owned, as maintainer and main contributor, the Django backend of an advanced robot teach pendant that lets non-experts program robot tasks graphically from parameterizable skills.',
      "Built Python (FastAPI) microservices that expose the robot's DDS nodes to web clients as GraphQL and REST APIs.",
      'Built CAN and Modbus interfaces to integrate a third-party mobile robot base with the robot workstation.',
      'Integrated the robot software stack on site at industrial customers in China over 4 months.',
      'Wrote unit and integration tests and CI pipelines for the software stack.',
    ],
    tech: 'Python, C++, Django, FastAPI, DDS, GraphQL, REST, CAN, Modbus, Docker, Conan, Vue, GitLab CI.',
  },
  {
    title: 'Software Developer (part-time)',
    company: 'H-BRS University',
    companyUrl: 'https://www.h-brs.de',
    location: 'Sankt Augustin, Germany',
    dates: 'Dec 2019 – Apr 2021',
    points: ['Extended a Django and Wagtail staff portal with custom features such as full-text document search.'],
  },
  {
    title: 'Research Assistant Robotics',
    company: 'United Arab Emirates University',
    companyUrl: 'https://www.uaeu.ac.ae',
    location: 'Al-Ain, UAE',
    dates: 'Apr 2017 – Feb 2019',
    points: [
      'Designed electronic circuits and PCBs and programmed microcontroller firmware (Arduino, ESP8266, Raspberry Pi).',
      'Designed mechanical parts in CAD and built 3D-printed prototypes of robotic devices.',
      'Developed robot navigation, pick-and-place and computer vision functions.',
    ],
  },
  {
    title: 'Research and Teaching Assistant',
    company: 'American University of Sharjah',
    companyUrl: 'https://www.aus.edu',
    location: 'Sharjah, UAE',
    dates: '2015 – 2017',
    points: [
      'Implemented BLDC, stepper, DC and linear coil motor control: PID control, friction compensation, adaptive control, state observers.',
      'Modeled electromechanical systems, identified their parameters from measured data, and applied MIMO control.',
    ],
  },
];

const skills = [
  ['Embedded', 'C (bare-metal, Microchip PIC24), Arduino, ESP8266, Raspberry Pi, JTAG/SWD debugging, CAN, Modbus, SPI, UART, I2C, TCP/IP, UDP'],
  [
    'Control and Motors',
    'PID control, friction compensation, adaptive control, state observers, system identification, MIMO control, Kalman and particle filters; BLDC, stepper, DC and linear coil motors',
  ],
  [
    'Test and Verification',
    'Python test automation, IVI instrument control, lab instruments, unit and integration testing (Python, C), CI/CD (GitLab), Docker',
  ],
  ['Programming Languages', 'Python, C++, C, JavaScript, MATLAB, Dart (Flutter), Rust'],
  ['Robotics', 'Kinematics, path planning (A*, RRT*), trajectory tracking, ROS, DDS, OpenCV'],
  ['Software Design and Process', 'UML, software architecture, Git, Jira, Agile Scrum'],
  ['Hardware and Mechanical', 'CAD (Fusion 360, Inventor, Creo, AutoCAD), 3D-printed prototyping, PCB design (Eagle)'],
];

const education = [
  {
    institution: 'Hochschule Bonn-Rhein-Sieg (H-BRS)',
    url: 'https://www.h-brs.de',
    location: 'Sankt Augustin, Germany',
    dates: '2019 – 2021',
    degree: 'Graduate coursework, M.Sc. Autonomous Systems program',
    points: [],
  },
  {
    institution: 'American University of Sharjah',
    url: 'https://www.aus.edu',
    location: 'Sharjah, UAE',
    dates: '2015 – 2017',
    degree: 'M.Sc. in Mechatronics Engineering',
    points: [
      'GPA: 3.77/4.0 (Excellent)',
      'Thesis: Multi-Robot Map Exploration Based on Multiple Rapidly-exploring Randomized Trees',
    ],
  },
  {
    institution: 'Jordan University of Science and Technology',
    url: 'https://www.just.edu.jo',
    location: 'Irbid, Jordan',
    dates: '2009 – 2014',
    degree: 'B.Sc. in Mechanical Engineering',
    points: [
      'GPA: 80.8/100 (Very Good) — Ranked 10th out of 128 graduates',
      'Thesis: System Modeling of a Variable Pitch Quadrotor',
    ],
  },
];

const languages = [
  ['Arabic', 'Native'],
  ['English', 'Proficient (97 TOEFL iBT, 2017)'],
  ['German', 'Intermediate (Goethe B2, 2026)'],
];
---

<Layout title="CV — Hassan Umari" description="Curriculum Vitae of Hassan Umari — Software & Mechatronics Engineer.">
  <div class="cv-top">
    <div>
      <h1>Curriculum Vitae</h1>
    </div>
    <a class="btn btn--primary" href="/cv.pdf" target="_blank" rel="noopener">
      Download PDF
    </a>
  </div>

  <section>
    <h2>Summary</h2>
    <p>
      Software and Mechatronics Engineer with a strong foundation in robotics
      (kinematics, motion planning, navigation), state estimation, control
      theory, embedded systems, and backend development. Builds backend services
      (Python, Django) and robot software (C++, Python, ROS, DDS), down to
      low-level drivers and hardware interfaces (CAN, Modbus, SPI, UART, I2C).
      Also comfortable with web frontends and mechanical design (3D CAD, force
      analysis) when a project needs them. Follows agile development, with unit
      and integration tests automated in CI. M.Sc. in Mechatronics Engineering
      with a thesis on autonomous robotic exploration; research published in top
      venues including IROS and Robotics and Autonomous Systems.
    </p>
  </section>

  <section>
    <h2>Skills</h2>
    <dl class="skills">
      {
        skills.map(([k, v]) => (
          <div class="skill-row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <h2>Work Experience</h2>
    {
      work.map((job) => (
        <div class="entry">
          <div class="entry-head">
            <div>
              <span class="entry-title">{job.title}</span>
              <span class="entry-org">
                {' · '}
                <a href={job.companyUrl} target="_blank" rel="noopener">
                  {job.company}
                </a>
                {job.extra && (
                  <>
                    {'  ·  '}
                    <a href={job.extraUrl} target="_blank" rel="noopener">
                      {job.extra}
                    </a>
                  </>
                )}
              </span>
            </div>
            <span class="entry-dates">{job.dates}</span>
          </div>
          <div class="entry-loc muted">{job.location}</div>
          <ul>
            {job.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          {job.tech && (
            <p class="tech">
              <strong>Tech Stack:</strong> {job.tech}
            </p>
          )}
        </div>
      ))
    }
  </section>

  <section>
    <h2>Earlier Experience</h2>
    <ul>
      <li>
        <strong>Junior Automation Engineer</strong>, Al-Wefaq Control Systems –
        Amman, Jordan (2014)
      </li>
    </ul>
  </section>

  <section>
    <h2>Education</h2>
    {
      education.map((e) => (
        <div class="entry">
          <div class="entry-head">
            <div>
              <span class="entry-title">{e.degree}</span>
              <span class="entry-org">
                {' · '}
                <a href={e.url} target="_blank" rel="noopener">
                  {e.institution}
                </a>
              </span>
            </div>
            <span class="entry-dates">{e.dates}</span>
          </div>
          <div class="entry-loc muted">{e.location}</div>
          {e.points.length > 0 && (
            <ul>
              {e.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </section>

  <section>
    <h2>Publications</h2>
    <ol class="pubs">
      <li>
        Hassan Umari and Shayok Mukhopadhyay, <em>Autonomous Robotic Exploration
        Based on Multiple Rapidly-Exploring Randomized Trees</em>, in Proc. of the
        IEEE/RSJ International Conference on Intelligent Robots and Systems
        (IROS), Vancouver, BC, Canada, 2017, pp. 1396–1402.
        <a href="https://doi.org/10.1109/IROS.2017.8202319" target="_blank" rel="noopener">
          doi:10.1109/IROS.2017.8202319</a>.
      </li>
      <li>
        Mukhopadhyay, S., Umari, H. &amp; Koirala, K. <em>Multi-robot Map
        Exploration Based on Multiple Rapidly-Exploring Randomized Trees</em>. SN
        Computer Science 5, 31 (2024).
        <a href="https://doi.org/10.1007/s42979-023-02193-2" target="_blank" rel="noopener">
          doi:10.1007/s42979-023-02193-2</a>.
      </li>
      <li>
        Alnajjar, F., Umari, H., Ahmed, W. K., et al. (2021).
        <a href="https://www.sciencedirect.com/science/article/abs/pii/S0921889021000695" target="_blank" rel="noopener">
          <em>CHAD: Compact Hand-Assistive Device for enhancement of function in
          hand impairments</em></a>. Robotics and Autonomous Systems, 142, 103784.
      </li>
    </ol>
    <p class="muted">
      Full publication list:
      <a href="https://scholar.google.com/citations?user=pp_B6ecAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>.
    </p>
  </section>

  <section>
    <h2>Languages</h2>
    <dl class="skills">
      {
        languages.map(([k, v]) => (
          <div class="skill-row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Layout>

<style>
  .cv-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .cv-top h1 {
    margin-bottom: 0.25rem;
  }
  section {
    margin-top: 1rem;
  }
  section h2 {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.35rem;
  }
  .entry {
    margin: 1.4rem 0;
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .entry-title {
    font-weight: 650;
  }
  .entry-org {
    color: var(--text-muted);
  }
  .entry-dates {
    color: var(--text-muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .entry-loc {
    font-size: 0.88rem;
    margin-top: 0.1rem;
  }
  .entry ul {
    margin: 0.6rem 0 0.5rem;
    padding-left: 1.15rem;
  }
  .entry li {
    margin-bottom: 0.3rem;
  }
  .tech {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0.3rem 0 0;
  }
  .tech strong {
    color: var(--text);
  }
  .skills {
    margin: 0;
  }
  .skill-row {
    display: flex;
    gap: 0.75rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .skill-row:last-child {
    border-bottom: none;
  }
  .skill-row dt {
    flex: 0 0 11rem;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .skill-row dd {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .pubs {
    padding-left: 1.15rem;
  }
  .pubs li {
    margin-bottom: 0.9rem;
    font-size: 0.94rem;
  }
  @media (max-width: 560px) {
    .skill-row {
      flex-direction: column;
      gap: 0.15rem;
    }
    .skill-row dt {
      flex-basis: auto;
    }
  }
</style>
